<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dialog_alert_outer_padding"
    android:paddingTop="@dimen/dialog_alert_outer_padding"
    android:paddingEnd="@dimen/dialog_alert_outer_padding"
    android:paddingBottom="@dimen/dialog_alert_outer_padding">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/ms_surface_card"
        app:cardCornerRadius="@dimen/dialog_alert_corner_radius"
        app:cardElevation="@dimen/ms_elev_0"
        app:strokeColor="@color/ms_border_default"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dialog_alert_content_padding"
            android:paddingTop="@dimen/dialog_alert_content_padding"
            android:paddingEnd="@dimen/dialog_alert_content_padding"
            android:paddingBottom="@dimen/dialog_alert_content_padding">

            <TextView
                style="@style/AppText.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_explore_category_pill"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/auth_reset_badge"
                android:textColor="@color/home_ref_hero_start" />

            <TextView
                android:id="@+id/tvResetDialogTitle"
                style="@style/HomeText.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:text="@string/auth_reset_title" />

            <TextView
                android:id="@+id/tvResetDialogMessage"
                style="@style/HomeText.ProductSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_alert_message_top_margin"
                android:text="@string/auth_reset_message"
                android:textColor="@color/details_text_muted" />

            <EditText
                android:id="@+id/etResetEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_18"
                android:background="@drawable/bg_edit_text"
                android:fontFamily="@font/manrope_regular"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:singleLine="true"
                android:textColor="@color/ms_text_primary"
                android:textColorHint="@color/ms_text_tertiary"
                android:textSize="@dimen/text_size_body"
                tools:text="client@email.com" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_alert_actions_top_margin"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetCancel"
                    style="@style/AppButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dialog_alert_button_height"
                    android:layout_weight="1"
                    android:text="@string/profile_edit_cancel" />

                <Space
                    android:layout_width="@dimen/dialog_alert_actions_gap"
                    android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetSend"
                    style="@style/AppButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dialog_alert_button_height"
                    android:layout_weight="1"
                    android:text="@string/auth_reset_send" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
