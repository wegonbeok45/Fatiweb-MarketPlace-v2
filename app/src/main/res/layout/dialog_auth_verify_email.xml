<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dialog_alert_outer_padding"
    android:paddingTop="@dimen/dialog_alert_outer_padding"
    android:paddingEnd="@dimen/dialog_alert_outer_padding"
    android:paddingBottom="@dimen/dialog_alert_outer_padding">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/ms_surface_card"
        app:cardCornerRadius="@dimen/dialog_alert_corner_radius"
        app:cardElevation="@dimen/ms_elev_0"
        app:strokeColor="@color/ms_border_default"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/dialog_alert_content_padding"
            android:paddingTop="@dimen/dialog_alert_content_padding"
            android:paddingEnd="@dimen/dialog_alert_content_padding"
            android:paddingBottom="@dimen/dialog_alert_content_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardBackgroundColor="@color/home_ref_surface_alt"
                app:cardCornerRadius="@dimen/corner_radius_round"
                app:cardElevation="@dimen/ms_elev_0"
                app:strokeColor="@color/ms_border_default"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_feedback_check"
                    app:tint="@color/ms_text_primary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvVerifyDialogTitle"
                style="@style/HomeText.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/auth_verify_created_title" />

            <TextView
                android:id="@+id/tvVerifyDialogMessage"
                style="@style/HomeText.ProductSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_alert_message_top_margin"
                android:gravity="center"
                android:textColor="@color/details_text_muted"
                tools:text="A verification link was sent to client@email.com. Open your inbox and click the link." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyDialogOk"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_alert_button_height"
                android:layout_marginTop="@dimen/dialog_alert_actions_top_margin"
                android:text="@string/auth_verify_dialog_ok" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
